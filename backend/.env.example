# Sao chep thanh .env roi chinh lai cho may cua ban. KHONG commit file .env.
APP_ENV=development
DB_DRIVER=postgres
DB_SOURCE=postgresql://postgres:postgres@localhost:5432/ltm?sslmode=disable
# Khoa doi xung 32 ky tu cho token PASETO
TOKEN_SYMMETRIC_KEY=12345678901234567890123456789012
ACCESS_TOKEN_DURATION=24h

# Kenh noi bo C <-> Go (docs/BRIDGE-PROTOCOL.md)
BRIDGE_NETWORK=tcp
BRIDGE_ADDRESS=:9100
BRIDGE_LOG_PATH=logs/bridge.log

# Tuy chon (chua dung o giai doan 3)
REDIS_ADDRESS=
MAIL_SENDER_NAME=
MAIL_SENDER_ADDRESS=
MAIL_SENDER_PASSWORD=
STRIPE_SECRET_KEY=
